{
  "name": "kansoku-ts",
  "version": "0.1.0",
  "private": true,
  "description": "React and JS client for kansoku",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "just typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "build": "just build",
    "test": "just test",
    "release": "bun run build && bun x --no-install changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1",
    "@types/bun": "1.4.2",
    "openapi-typescript": "^7.13.0",
    "publint": "0.3.25",
    "typescript": "^5.9"
  }
}
